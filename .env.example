# Copy to .env. Both are optional; the defaults suit running everything on this computer.

# Where the dev server forwards /api requests.
API_PROXY_TARGET=http://127.0.0.1:8000

# Only for production builds served from a different origin than the API.
# That origin must also be listed in the backend's CORS_ORIGINS.
# VITE_API_BASE_URL=http://192.168.1.10:8000
